#!/usr/bin/env python3
"""tmux crew CLI (docs/runtimes/tmux.md). Python 3.11+ stdlib only.

Usage: crew up --project FILE [--org-profile FILE] [--inputs DIR]
       crew down --project FILE [--org-profile FILE]
       crew spawn ROLE --issue N | --pr N [--pass PASS] [--round K] [--tier T] --project FILE [--org-profile FILE]
       crew kill WINDOW [--discard --reason TEXT] --project FILE [--org-profile FILE]
       crew send WINDOW KIND REF... [--wait-ack SECS] --project FILE
       crew acked WINDOW MSG-ID [--wait SECS] --project FILE
       crew poll [--once] --project FILE
       crew attach WINDOW|ROLE|builders [--rw] --project FILE [--org-profile FILE]
       crew logs WINDOW [-n N] [-f] --project FILE [--org-profile FILE]
       crew land-lock acquire|release --project FILE [--org-profile FILE]
       crew dequeue [--timeout SECS] --project FILE [--org-profile FILE]
       crew drain --project FILE [--org-profile FILE]
       crew guard --state DIR   (Claude Code Stop hook; reads the hook JSON on stdin)
       crew watch | status | restart WINDOW --project FILE [--org-profile FILE]
"""
import argparse
import contextlib
import fcntl
import glob
import importlib.util
import io
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))


def load(name, file):
    spec = importlib.util.spec_from_file_location(name, os.path.join(HERE, file))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


crew_render, tmux = load("crew_render", "crew-render.py"), load("crew_tmux", "crew-tmux.py")
POINTER = "Read your brief at $CREW_BRIEF and follow it."
# The token is derived inside the window's shell: never in argv, -e or a file (tmux.md Q5).
LAUNCH = 'export GH_TOKEN="$(gh auth token --user "$CREW_IDENTITY")"; exec %s "%s"'
ENGINE_CMD = {"claude-code": "claude", "codex": "codex"}
CREW_BIN = os.path.join(HERE, "crew")  # this checkout's CLI, for briefs to call as $CREW_BIN (#139 F1)
# Role windows (tmux.md Layout and naming): index band, passes (first is the default), default name.
BANDS = {"builder": (10, 19), "reviewer": (20, 29), "synthesizer": (1, 1)}
PASSES = {"builder": ["build", "fix"], "reviewer": ["review", "validate"], "synthesizer": ["land"]}
NAMES = {"builder": "ben", "reviewer": "vera", "synthesizer": "sam"}
TEMPLATES = os.path.join(os.path.dirname(HERE), "templates")


def brief_src(state, role):
    """Rendered role brief: briefs/<role>.md from core/, else the runtime binding's runtime/<role>.md (#137)."""
    core = os.path.join(state, "render", "briefs", role + ".md")
    return core if os.path.exists(core) else os.path.join(state, "render", "runtime", role + ".md")


def profile(args):
    """Resolved profile, session name and state dir; exit 1 on a resolve problem or a non-tmux runtime."""
    values, problems = crew_render.resolve(args.project, args.org_profile)
    if values and values["runtime.name"] != "tmux":
        problems = ["%s:runtime.name: runtime.name is %s, not tmux" % (args.project, values["runtime.name"])]
    if problems:
        print("\n".join(problems))
        sys.exit(1)
    owner, repo = values["repo.owner"], values["repo.name"]
    session = values.get("runtime.options.session") or "crew-%s-%s" % (owner, repo)
    return values, session, os.path.join(os.path.abspath(values["paths.state_dir"]), "%s__%s" % (owner, repo))


def install_stop_hook(project_dir, state):
    """Add the turn-end guard to the project's local Claude settings, once, keeping every other key."""
    path = os.path.join(project_dir, ".claude", "settings.local.json")
    settings = {}
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            settings = json.load(f)
    command = shlex.join(["python3", os.path.join(HERE, "crew"), "guard", "--state", state])
    stop = settings.setdefault("hooks", {}).setdefault("Stop", [])
    if not any(h.get("command") == command for entry in stop for h in entry.get("hooks", [])):
        stop.append({"hooks": [{"type": "command", "command": command}]})
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")


def up(args):
    values, session, state = profile(args)
    if tmux.has_session(session):
        print("crew: %s already running; attach with: tmux attach -t %s" % (session, session))
        return 0
    render = os.path.join(state, "render")
    with contextlib.redirect_stdout(io.StringIO()) as out, contextlib.redirect_stderr(out):  # chatter only on failure
        code = crew_render.main(["--project", args.project, "--inputs", args.inputs, "--out", render] +
                                (["--org-profile", args.org_profile] if args.org_profile else []))
    if code:
        print(out.getvalue(), end="")
        return 1
    project_dir = os.path.dirname(os.path.abspath(args.project))
    engine = values["engines.coordinator"]
    if engine == "claude-code":
        install_stop_hook(project_dir, state)
    env = {"CREW_ROLE": "coordinator", "CREW_STATE": state, "CREW_IDENTITY": values["identities.coordinator.gh_user"],
           "CREW_BRIEF": brief_src(state, "coordinator"), "CREW_BIN": CREW_BIN, **sandbox_env()}
    window = values.get("identities.coordinator.name", "ash").lower()
    cmd = ENGINE_CMD[engine] if engine == "claude-code" else shlex.join(  # Claude Code: trust dialog (tmux.md)
        ["codex", "-c", 'projects."%s".trust_level="trusted"' % project_dir])
    tmux.new_session(session, window, project_dir, env, LAUNCH % (cmd, POINTER))
    print("crew: started %s (window 0 %s, %s); attach with: tmux attach -t %s" % (session, window, engine, session))
    reconcile(state)
    return 0


def down(args):
    values, session, state = profile(args)
    if not tmux.has_session(session):
        print("crew: %s not running" % session)
        return 0
    lock = os.path.join(state, "locks", "merge.lock")
    if os.path.exists(lock):
        with open(lock) as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print("crew: refusing down: the land lock %s is held" % lock)
                return 1
    held = [name for index, name in sorted(tmux.list_windows(session), reverse=True)  # coordinator last
            if index != 0 and kill_run(values, session, state, name)]
    if held:
        print("crew: refusing down: unlanded work in %s; land it or crew kill --discard --reason" % ", ".join(held))
        return 1
    pgid = stop_pane(session, 0)
    if pgid:
        print("crew: refusing down: process group %d in window 0 survived SIGKILL" % pgid)
        return 1
    tmux.kill_session(session)
    print("crew: stopped %s" % session)
    return 0


def guard(args):
    """Block a turn end while work is in flight (a run record or a queued wake) and no watcher is armed.

    At most one block per stop cycle: with stop_hook_active true (already continuing for this hook), allow
    with a warning. Malformed or empty stdin counts as not active. A no-op outside the
    coordinator window: the hook file sits in the project, so role windows load it too (#139 F5)."""
    if os.environ.get("CREW_ROLE") != "coordinator":
        return 0
    try:
        active = json.loads(sys.stdin.read()).get("stop_hook_active") is True
    except (ValueError, AttributeError):
        active = False
    runs = os.path.join(args.state, "runs")
    queue = os.path.join(args.state, "wake", "queue.jsonl")
    busy = (os.path.isdir(runs) and any(n.endswith(".json") for n in os.listdir(runs))) or \
        (os.path.exists(queue) and os.path.getsize(queue) > 0)
    try:
        with open(os.path.join(args.state, "wake", "watcher.pid")) as f:
            os.kill(int(f.read().strip()), 0)
        armed = True
    except (OSError, ValueError):
        armed = False
    msg = "Work is in flight and no watcher is armed: drain wake/queue.jsonl and re-arm the watcher " \
        "before ending the turn (docs/runtimes/tmux.md Q1)."
    if busy and not armed:
        print(json.dumps({"systemMessage": "crew guard: " + msg} if active else {"decision": "block", "reason": msg}))
    return 0


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("crew: git %s failed: %s" % (args[0], r.stderr.strip()))
    return r.stdout.strip()


def fetch(repo, ref):
    """Fresh base: always the just-fetched remote ref, never a possibly stale local one."""
    git(repo, "fetch", "-q", "origin", ref)
    return git(repo, "rev-parse", "FETCH_HEAD")


def pick_engine(values, tier, avoid=None):
    """First interactive engine in the tier's order; a reviewer avoids every actual builder engine of the PR, and
    an unknown builder engine counts as non-Claude (roles.md Reviewer engine selection)."""
    order = [e.split("/", 1) for e in values["engines.%s.order" % tier]]
    order = [e for e in order if e[0] in ENGINE_CMD and e[0] not in (avoid or ())]
    if avoid == set():
        order.sort(key=lambda e: e[0] != "claude-code")
    if not order:
        raise RuntimeError("crew: no %s engine in engines.%s.order differs from the builder's %s" %
                           ("/".join(ENGINE_CMD), tier, sorted(avoid or ())))
    return order[0][0], order[0][1], values["engines.%s.effort" % tier]


def harness(engine, model, effort, pass_, wt):
    if engine == "claude-code":
        return ["claude", "--model", model, "--effort", effort, "--permission-mode", "acceptEdits"]
    return ["codex", "-m", model, "-c", "model_reasoning_effort=" + effort,
            "-c", 'projects."%s".trust_level="trusted"' % wt,  # pre-trust this run's worktree only
            "-s", "read-only" if pass_ in ("review", "validate") else "workspace-write"]


def unlanded(values, rec, wt):
    """Uncommitted or untracked paths, and commits not on the fetched default branch, run branch or PR head."""
    items = ["uncommitted: " + line for line in git(wt, "status", "--porcelain", "--untracked-files=all").split("\n")
             if line]
    landed = [fetch(wt, values["repo.default_branch"])]
    branch = subprocess.run(["git", "-C", wt, "symbolic-ref", "-q", "--short", "HEAD"], capture_output=True, text=True)
    refs = [branch.stdout.strip()] if branch.returncode == 0 else []
    refs += ["pull/%s/head" % n for n in re.findall(r"PR #(\d+)", rec.get("item", ""))]
    for ref in refs:
        try:
            landed.append(fetch(wt, ref))
        except RuntimeError:  # not on the remote: its commits count as unlanded
            pass
    log = git(wt, "log", "--format=%H %s", "HEAD", "--not", *landed)
    return items + ["commit: " + line for line in log.split("\n") if line]


def record_discard(values, rec, name, reason, items):
    """Post the owner's discard reason on the run's PR (narrative post) or issue; False if it was not posted."""
    pr, issue = re.search(r"PR #(\d+)", rec.get("item", "")), re.search(r"issue #(\d+)", rec.get("item", ""))
    body = "[%s/kill] discarded unlanded work in %s\n\nReason: %s\n\n%s" % (
        values.get("identities.coordinator.name", "Ash"), name, reason, "\n".join("- `%s`" % i for i in items))
    repo = "%s/%s" % (values["repo.owner"], values["repo.name"])
    cmd = (["gh", "pr", "review", pr.group(1), "--comment", "-R", repo] if pr else
           ["gh", "issue", "comment", issue.group(1), "-R", repo] if issue else None)
    return cmd is not None and subprocess.run(cmd + ["--body", body], capture_output=True).returncode == 0


def stop_pane(session, index, grace=2.0):
    """SIGTERM the pane's process group, SIGKILL what is left after grace seconds; return the pgid if it survives.

    kill-window alone sends SIGHUP, which Codex ignores (#139 F2). The caller's own group (crew down run from
    window 0) is left to kill-session."""
    try:
        pgid = os.getpgid(int((tmux.pane(session, index) or {})["pid"]))
    except (KeyError, ValueError, ProcessLookupError):
        return None
    if pgid <= 1 or pgid == os.getpgrp():
        return None
    for sig in (signal.SIGTERM, signal.SIGKILL):
        with contextlib.suppress(ProcessLookupError, PermissionError):  # EPERM: a group still exiting (macOS)
            os.killpg(pgid, sig)
        deadline = time.monotonic() + grace
        while time.monotonic() < deadline:
            try:
                os.killpg(pgid, 0)
            except ProcessLookupError:
                return None
            except PermissionError:
                pass
            time.sleep(0.05)
    return pgid


def kill_run(values, session, state, name, reason=None):
    """Stop the window, then remove only this run's worktree (build output inside it) and state files.

    Removal needs the window's processes gone and the work landed, or a discard reason recorded on the item;
    otherwise keep the worktree and state files and return the blocking items."""
    for index, n in tmux.list_windows(session):
        if n == name:
            pgid = stop_pane(session, index)
            if pgid:
                print("crew: refusing to remove %s: process group %d survived SIGKILL" % (name, pgid))
                return ["alive: process group %d" % pgid]
            tmux.kill_window(session, index)
    path = os.path.join(state, "runs", name + ".json")
    rec = {}
    if os.path.exists(path):
        with open(path) as f:
            rec = json.load(f)
    wt = rec.get("worktree")
    if wt and os.path.dirname(os.path.realpath(wt)) == os.path.realpath(values["paths.worktree_root"]):
        try:
            items = unlanded(values, rec, wt) if os.path.isdir(wt) else []
        except RuntimeError as e:
            items = ["unchecked: %s" % e]
        if items and (reason is None or not record_discard(values, rec, name, reason, items)):
            print("crew: refusing to remove %s: unlanded work in %s%s:\n  %s" % (
                wt, name, "" if reason is None else " (discard reason not recorded on the item)", "\n  ".join(items)))
            return items
        subprocess.run(["git", "-C", rec["repo"], "worktree", "remove", "--force", wt], capture_output=True)
        shutil.rmtree(wt, ignore_errors=True)
        subprocess.run(["git", "-C", rec["repo"], "worktree", "prune"], capture_output=True)
    for p in [path, os.path.join(state, "runs", name + ".brief.md"), os.path.join(state, "inbox", name + ".jsonl"),
              os.path.join(state, "status", name + ".status"), rec.get("claim")]:
        if p and os.path.exists(p):
            os.remove(p)
    return []


def sandbox_env():
    """CREW_SANDBOX_ENV=NAME=VALUE from the org pack, for every window whatever its engine (#139 F8)."""
    key, sep, value = os.environ.get("CREW_SANDBOX_ENV", "").partition("=")
    return {key: value} if key and sep else {}


def window_env(values, state, role, name, brief):
    """The role window's -e variables: names, paths and the login only, never a token (tmux.md Q5)."""
    return {"CREW_ROLE": role, "CREW_ID": name, "CREW_STATE": state, "CREW_BRIEF": brief, "CREW_BIN": CREW_BIN,
            "CREW_STATUS": os.path.join(state, "status", name + ".status"),
            "CREW_INBOX": os.path.join(state, "inbox", name + ".jsonl"),
            "CREW_IDENTITY": values["identities.%s.gh_user" % role], **sandbox_env()}


def wait_harness(session, index, name, expected, timeout):
    """Verify start: the expected harness must reach the foreground within timeout seconds."""
    deadline = time.monotonic() + timeout
    while (seen := tmux.pane_command(session, index)) != expected:
        if time.monotonic() > deadline:
            raise RuntimeError("failed: %s: foreground is %r, not %s, after %ss; cleaned up" % (
                name, seen, expected, timeout))
        time.sleep(0.2)


def spawn(args):
    values, session, state = profile(args)
    role = args.role
    pass_ = args.pass_ or PASSES[role][1 if role == "builder" and args.pr else 0]
    if pass_ not in PASSES[role] or bool(args.issue) != (role == "builder") or \
            bool(args.pr) != (role != "builder" or pass_ == "fix"):
        print("crew: %s %s takes %s" % (role, pass_, "--issue N --pr N" if pass_ == "fix" else
                                         "--issue N" if role == "builder" else "--pr N"))
        return 2
    nm = values.get("identities.%s.name" % role, NAMES[role]).lower()
    name = {"builder": "%s-%s" % (nm, args.issue), "synthesizer": nm,
            "reviewer": "%s-%s-r%d-%s" % (nm, args.pr, args.round, pass_)}[role]
    if not tmux.has_session(session):
        print("crew: session %s not reachable (tmux socket, or run crew up first)" % session)
        return 1
    tmux.pin_layout(session)
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    free = [i for i in range(BANDS[role][0], BANDS[role][1] + 1) if i not in windows.values()]
    if name not in windows and over_cap(values, role, windows):
        return enqueue(state, args, pass_)
    src = brief_src(state, role)
    problem = ("%s already running" % name if name in windows else "band %d-%d full" % BANDS[role] if not free
               else "no rendered brief %s (run crew up)" % src if not os.path.exists(src) else None)
    if problem:
        print("crew: refusing spawn: " + problem)
        return 1
    try:
        repo = git(os.path.dirname(os.path.abspath(args.project)), "rev-parse", "--show-toplevel")
        sha = fetch(repo, "pull/%d/head" % args.pr if args.pr else values["repo.default_branch"])
        engine, model, effort = pick_engine(values, args.tier) if role == "builder" else pick_engine(
            values, args.tier, {line.split()[0] for line in git(
                repo, "log", "--format=%(trailers:key=Engine,valueonly)",
                "%s..%s" % (fetch(repo, values["repo.default_branch"]), sha)).splitlines()
                if line.strip() and not line.startswith("none")})
    except RuntimeError as e:
        print(e)
        return 1
    claim = os.path.join(state, "claims", "builder-issue%s" % args.issue if pass_ == "build" else
                         "%s-pr%d-%s" % (role, args.pr, sha[:7]))
    for d in ["claims", "runs", "inbox", "status"]:
        os.makedirs(os.path.join(state, d), exist_ok=True)
    try:
        os.close(os.open(claim, os.O_CREAT | os.O_EXCL | os.O_WRONLY))  # atomic claim (protocol §6 step 2)
    except FileExistsError:
        print("crew: refusing spawn: claim %s exists" % claim)
        return 1
    item = "issue #%s" % args.issue if role == "builder" else "PR #%d" % args.pr
    item += ", PR #%d" % args.pr if pass_ == "fix" else ""
    wt = os.path.join(os.path.abspath(values["paths.worktree_root"]), "%d-%s-%s-%s" % (
        args.pr or args.issue, sha[:7], role, pass_))
    rec = {"index": free[0], "role": role, "item": item, "pass": pass_, "repo": repo, "worktree": None, "claim": claim,
           "engine": engine, "model": model, "effort": effort, "harness": ENGINE_CMD[engine]}

    def save():
        with open(os.path.join(state, "runs", name + ".json"), "w") as f:
            json.dump(rec, f, indent=2)

    save()
    try:
        real, top = os.path.realpath(wt), os.path.realpath(repo)
        if real == top or real.startswith(top + os.sep):
            raise RuntimeError("crew: refusing spawn: %s is inside the primary checkout %s" % (wt, repo))
        if os.path.lexists(wt):
            raise RuntimeError("crew: refusing spawn: %s exists" % wt)
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        git(repo, "worktree", "add", "-q", "--detach", wt, sha)
        rec["worktree"] = wt
        save()
        brief = os.path.join(state, "runs", name + ".brief.md")
        with open(src, encoding="utf-8") as f, open(brief, "w", encoding="utf-8") as out:
            out.write(f.read() + "\n## This run\n\n" + "".join("- %s: %s\n" % kv for kv in [
                ("Window", name), ("Item", item), ("Pass", pass_), ("Worktree", wt), ("Base", sha),
                ("Engine", "%s %s %s" % (engine, model, effort)), ("Claim", claim)]))
        tmux.new_window(session, free[0], name, wt, window_env(values, state, role, name, brief),
                        LAUNCH % (shlex.join(harness(engine, model, effort, pass_, wt)), POINTER))
        wait_harness(session, free[0], name, ENGINE_CMD[engine], args.timeout)
    except (RuntimeError, OSError) as e:
        kill_run(values, session, state, name)
        print(e)
        return 1
    rec["start"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    rec.update(identity(session, free[0]), args={"issue": args.issue, "pr": args.pr, "pass": pass_,
                                                 "round": args.round, "tier": args.tier})
    save()
    print("crew: started %s (window %d, %s %s %s) in %s" % (name, free[0], engine, model, effort, wt))
    return 0


def kill(args):
    if args.discard and not args.reason:
        print("crew: --discard needs --reason \"<why>\" (the owner's decision, posted on the item)")
        return 2
    values, session, state = profile(args)
    if tmux.has_session(session):
        tmux.pin_layout(session)
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    if windows.get(args.window) == 0:
        print("crew: refusing to kill the coordinator window; use crew down")
        return 1
    if args.window not in windows and not os.path.exists(os.path.join(state, "runs", args.window + ".json")):
        print("crew: no run %s" % args.window)
        return 1
    if kill_run(values, session, state, args.window, args.reason if args.discard else None):
        return 1
    print("crew: killed %s" % args.window)
    return 0


# crew send (tmux.md C3): refs only. A ref is an issue/PR number, a full SHA, an https link or a path; no whitespace,
# so no diff or log fits, and lines that open a diff hunk or a traceback are refused outright.
KIND = re.compile(r"[a-z][a-z0-9-]{0,31}")
REF = re.compile(r"#\d+|[0-9a-f]{40}|https://[^\s]+|[\w.~/-]+")
MARKER = re.compile(r"^(---|\+\+\+|@@)|Traceback")
MAX_REF, MAX_LINE = 200, 1024


def acked(state, window, msg_id):
    """Delivery proof: an `ack: <msg-id>` line in the window's status file, nothing else."""
    try:
        with open(os.path.join(state, "status", window + ".status"), encoding="utf-8") as f:
            return any(line.split()[:2] == ["ack:", msg_id] for line in f)
    except FileNotFoundError:
        return False


def wait_ack(state, window, msg_id, secs):
    deadline = time.monotonic() + secs
    while not acked(state, window, msg_id):
        if time.monotonic() >= deadline:
            print("crew: no ack: %s from %s after %ss" % (msg_id, window, secs))
            return 3
        time.sleep(0.2)
    print("crew: acked %s by %s" % (msg_id, window))
    return 0


def send(args):
    values, session, state = profile(args)
    bad = [r for r in args.refs if len(r) > MAX_REF or not REF.fullmatch(r) or MARKER.search(r)]
    if not KIND.fullmatch(args.kind) or bad:
        print("crew: refusing send: refs only (issue/PR #n, full SHA, https link, path; max %d chars each): %s" %
              (MAX_REF, ", ".join(repr(r[:40]) for r in bad) or "bad kind %r" % args.kind[:40]))
        return 2
    msg = {"id": "%s-%s" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.urandom(3).hex()), "kind": args.kind,
           "refs": args.refs, "from": os.environ.get("CREW_ID") or os.environ.get("CREW_ROLE") or "coordinator",
           "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    line = json.dumps(msg) + "\n"
    if len(line.encode()) > MAX_LINE:
        print("crew: refusing send: message is %d bytes, over %d; send fewer refs" % (len(line.encode()), MAX_LINE))
        return 2
    index = dict((n, i) for i, n in tmux.list_windows(session)).get(args.window) if tmux.has_session(session) else None
    if index is None:
        print("crew: refusing send: no window %s in %s" % (args.window, session))
        return 1
    os.makedirs(os.path.join(state, "inbox"), exist_ok=True)
    with open(os.path.join(state, "inbox", args.window + ".jsonl"), "a", encoding="utf-8") as f:
        f.write(line)
    tmux.send_keys(session, index, "inbox: " + msg["id"])  # a nudge only; the inbox file is the message
    print("crew: sent %s to %s" % (msg["id"], args.window))
    return wait_ack(state, args.window, msg["id"], args.wait_ack) if args.wait_ack is not None else 0


def acked_cmd(args):
    return wait_ack(profile(args)[2], args.window, args.id, args.wait)



# crew poll (tmux.md Q1, C2): one wake source. Read-only gh JSON for open crew PRs and crew:ready items is diffed
# against poll-state.json; each change becomes one wake record in wake/queue.jsonl naming one consuming role
# (protocol §8). The coordinator drains the queue and routes each record by crew send or crew spawn.
CONSUMER = {"ci-passed": "reviewer", "ci-failed": "builder", "review-changes-requested": "builder",
            "review-approved": "synthesizer", "pr-merged": "coordinator", "pr-closed": "coordinator",
            "issue-assigned": "builder"}
PR_FIELDS = "number,state,headRefOid,labels,statusCheckRollup,reviews"
CREW_LINE = re.compile(r"<!-- crew:v1 ([^>]*?) -->")
CI_OK, CI_BAD = {"SUCCESS", "NEUTRAL", "SKIPPED"}, {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED",
                                                    "STARTUP_FAILURE"}


def pr_snapshot(pr):
    """Head, CI rollup and the latest verdict at head, from the hidden crew:v1 lines only (protocol §4)."""
    head = pr["headRefOid"]
    results = [c.get("state") if c.get("__typename") == "StatusContext" else
               c.get("conclusion") if c.get("status") == "COMPLETED" else "PENDING" for c in pr["statusCheckRollup"]]
    ci = "failed" if CI_BAD & set(results) else "passed" if results and set(results) <= CI_OK else "pending"
    verdict = None
    for review in pr["reviews"]:
        for line in CREW_LINE.findall(review["body"]):
            m = dict(kv.split("=", 1) for kv in line.split() if "=" in kv)
            if m.get("role") == "reviewer-validator" and m.get("pass") == "verdict" and m.get("sha") == head:
                verdict = m.get("verdict")
    return {"head": head, "ci": ci, "verdict": verdict}


def decide(prev, prs, issues):
    """Pure: previous poll state plus gh JSON (open PRs, tracked PRs now merged or closed, open issues) -> (events,
    new state). A change emits one event; no change emits nothing."""
    events, state = [], {"prs": {}, "issues": []}

    def emit(event, *refs):
        events.append({"event": event, "consumer": CONSUMER[event], "refs": list(refs)})

    for pr in prs:
        n, cur = str(pr["number"]), pr_snapshot(pr)
        if pr["state"] != "OPEN":
            emit("pr-merged" if pr["state"] == "MERGED" else "pr-closed", "#" + n, cur["head"])
            continue
        if not any(label["name"].startswith("crew:") for label in pr["labels"]):
            continue
        old = prev.get("prs", {}).get(n, {})
        state["prs"][n] = cur
        if cur["ci"] in ("passed", "failed") and (cur["head"], cur["ci"]) != (old.get("head"), old.get("ci")):
            emit("ci-" + cur["ci"], "#" + n, cur["head"])
        if cur["verdict"] and (cur["head"], cur["verdict"]) != (old.get("head"), old.get("verdict")):
            emit("review-approved" if cur["verdict"] == "pass" else "review-changes-requested", "#" + n, cur["head"])
    state["issues"] = sorted(i["number"] for i in issues if i["assignees"] and
                             any(label["name"] == "crew:ready" for label in i["labels"]))
    for n in state["issues"]:
        if n not in prev.get("issues", []):
            emit("issue-assigned", "#%d" % n)
    return events, state


def gh_json(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("crew: gh %s failed: %s" % (" ".join(args[:2]), r.stderr.strip()))
    return json.loads(r.stdout)


@contextlib.contextmanager
def queue_lock(state):
    """wake/queue.lock: held around every queue.jsonl append and crew drain's rename, so no append is lost."""
    os.makedirs(os.path.join(state, "wake"), exist_ok=True)
    with open(os.path.join(state, "wake", "queue.lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def drain(args):
    """Print every queued wake record as a JSON line and empty the queue (renamed first, so none is lost)."""
    _, _, state = profile(args)
    queue = os.path.join(state, "wake", "queue.jsonl")
    with queue_lock(state):
        if os.path.exists(queue):
            os.rename(queue, "%s.drain-%d-%s" % (queue, os.getpid(), os.urandom(3).hex()))
    for path in sorted(glob.glob(queue + ".drain-*"), key=os.path.getmtime):  # also an interrupted drain's file
        with open(path, encoding="utf-8") as f:
            sys.stdout.writelines(line if line.endswith("\n") else line + "\n" for line in f if line.strip())
        sys.stdout.flush()
        os.remove(path)
    return 0


def poll_once(values, state):
    repo, path = "%s/%s" % (values["repo.owner"], values["repo.name"]), os.path.join(state, "poll-state.json")
    prev = None
    if os.path.exists(path):
        with open(path) as f:
            prev = json.load(f)
    prs = gh_json("pr", "list", "-R", repo, "--state", "open", "--limit", "200", "--json", PR_FIELDS)
    gone = set((prev or {}).get("prs", {})) - {str(pr["number"]) for pr in prs}
    prs += [gh_json("pr", "view", n, "-R", repo, "--json", PR_FIELDS) for n in sorted(gone)]
    issues = gh_json("issue", "list", "-R", repo, "--state", "open", "--label", "crew:ready", "--limit", "200",
                     "--json", "number,labels,assignees")
    events, new = decide(prev or {}, prs, issues)
    if prev is None:  # first run: record a baseline only; the §6 step 3 sweep covers what happened before it
        events = []
        print("crew: poll: baseline of %d PRs, %d issues" % (len(new["prs"]), len(new["issues"])))
    with queue_lock(state), open(os.path.join(state, "wake", "queue.jsonl"), "a", encoding="utf-8") as f:  # at-least-once
        for e in events:
            ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            f.write(json.dumps({"id": "poll-%s-%s" % (ts, os.urandom(3).hex()), "source": "poll", "reason": "poll", **e, "ts": ts}) + "\n")
            print("crew: poll: %s -> %s %s" % (e["event"], e["consumer"], " ".join(e["refs"])))
    with open(path + ".tmp", "w") as f:
        json.dump(new, f, indent=2)
    os.replace(path + ".tmp", path)


def poll(args):
    values, _, state = profile(args)
    while True:
        try:
            poll_once(values, state)
        except RuntimeError as e:
            print(e)
            if args.once:
                return 1
        if args.once:
            return 0
        time.sleep(values["runtime.options.poll_interval"])


# Observe (#138): attach to a window, or tail a run's step summary (docs/observe.md).
ROLE_BANDS = dict(BANDS, coordinator=(0, 0))
# One pane of the builders view: the last lines of a window's screen (trailing blanks dropped), refreshed every second.
# Values are single-quoted: shlex.quote leaves "=" bare, which zsh (a common default-shell) expands.
SNAPSHOT = "while :; do out=$(tmux capture-pane -p -t '%s' | awk 'NF { n = NR } { l[NR] = $0 } " \
    "END { for (i = 1; i <= n; i++) print l[i] }' | tail -n \"$(($(tput lines) - 1))\"); " \
    "printf '\\033[H\\033[2J== %%s ==\\n%%s' '%s' \"$out\"; sleep 1; done"


def attach(args):
    """Attach read-only (--rw to type) to a window, or to a role's only window; `builders` opens a temporary tiled
    view of the builder band in a separate session, killed on detach, so the crew layout never changes."""
    values, session, state = profile(args)
    if not tmux.has_session(session):
        print("crew: %s not running" % session)
        return 1
    windows = sorted(tmux.list_windows(session))
    if args.target == "builders":
        band = [(i, n) for i, n in windows if BANDS["builder"][0] <= i <= BANDS["builder"][1]]
        if not band:
            print("crew: no builder windows")
            return 1
        name = "%s-builders-%d" % (session, os.getpid())
        tmux.view(name, [SNAPSHOT % ("=%s:%d" % (session, i), n) for i, n in band])
        try:
            return tmux.attach("=" + name, not args.rw)
        finally:
            tmux.kill_session(name)
    found = [(i, n) for i, n in windows if n == args.target]
    if not found and args.target in ROLE_BANDS:
        lo, hi = ROLE_BANDS[args.target]
        found = [(i, n) for i, n in windows if lo <= i <= hi]
        if len(found) > 1:
            print("crew: %s has several windows (%s); name one" % (args.target, ", ".join(n for _, n in found)))
            return 1
    if not found:
        print("crew: no window %s in %s" % (args.target, session))
        return 1
    return tmux.attach("=%s:%d" % (session, found[0][0]), not args.rw)


def logs(args):
    """Print the tail of the newest step summary under the run's worktree; never raw logs (docs/observe.md)."""
    values, session, state = profile(args)
    path = os.path.join(state, "runs", args.window + ".json")
    if not os.path.exists(path):
        print("crew: no run %s" % args.window)
        return 1
    with open(path) as f:
        wt = json.load(f).get("worktree")
    found = glob.glob(os.path.join(wt, ".crew", "runs", "**", "summary.md"), recursive=True) if wt else []
    if not found:
        print("crew: no step summary yet under %s" % os.path.join(str(wt), ".crew", "runs"))
        return 1
    summary = max(found, key=os.path.getmtime)
    if args.follow:
        os.execvp("tail", ["tail", "-n", str(args.lines), "-f", summary])
    with open(summary, encoding="utf-8") as f:
        lines = f.read().splitlines()
    print("==> %s <==" % summary)
    print("\n".join(lines[-args.lines:]))
    return 0


CAPS = {"builder": "runtime.options.builders", "reviewer": "runtime.options.reviewers"}


def over_cap(values, role, windows):
    """True when the role's band holds its profile cap of windows, or is full (tmux.md Q6)."""
    used = [i for i in windows.values() if BANDS[role][0] <= i <= BANDS[role][1]]
    return role in CAPS and len(used) >= min(values[CAPS[role]], BANDS[role][1] - BANDS[role][0] + 1)


def enqueue(state, args, pass_):
    """Append a capped spawn request to spawn-queue.jsonl for the coordinator; no window is created."""
    entry = {"role": args.role, "issue": args.issue, "pr": args.pr, "pass": pass_, "round": args.round,
             "tier": args.tier, "queued": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    os.makedirs(state, exist_ok=True)
    with open(os.path.join(state, "spawn-queue.jsonl"), "a") as f:
        f.write(json.dumps(entry) + "\n")
    print("queued: %s %s %s (%s cap reached; run crew dequeue when a window closes)" % (
        args.role, pass_, "issue #%s" % args.issue if args.issue else "PR #%s" % args.pr, args.role))
    return 0


def dequeue(args):
    """Spawn the oldest queued request whose band has a free slot; leave the rest queued."""
    values, session, state = profile(args)
    path = os.path.join(state, "spawn-queue.jsonl")
    entries = []
    if os.path.exists(path):
        with open(path) as f:
            entries = [json.loads(line) for line in f if line.strip()]
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    pick = next((e for e in entries if not over_cap(values, e["role"], windows)), None)
    if pick is None:
        print("crew: nothing to dequeue (%d queued, no free slot)" % len(entries) if entries else
              "crew: spawn queue empty")
        return 0
    entries.remove(pick)
    with open(path, "w") as f:
        f.writelines(json.dumps(e) + "\n" for e in entries)
    return spawn(argparse.Namespace(role=pick["role"], issue=pick["issue"], pr=pick["pr"], pass_=pick["pass"],
                                    round=pick["round"], tier=pick["tier"], timeout=args.timeout,
                                    project=args.project, org_profile=args.org_profile))


def proc_identity(pid):
    """(start time, command line) of a live process from ps, or None; the start time tells a reused PID apart."""
    out = [subprocess.run(["ps", "-o", col + "=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
           for col in ("lstart", "command")]
    return tuple(out) if all(out) else None


def land_lock(args):
    """Serial land (tmux.md C7): acquire takes an flock on locks/merge.lock, held by a detached child until
    release; a second acquire fails fast."""
    _, _, state = profile(args)
    lock, pidfile = os.path.join(state, "locks", "merge.lock"), os.path.join(state, "locks", "merge.pid")
    os.makedirs(os.path.dirname(lock), exist_ok=True)
    if args.action == "acquire":
        fd = os.open(lock, os.O_CREAT | os.O_RDWR)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("crew: land lock %s is held; another land is in progress" % lock)
            return 1
        pid = os.fork()
        if pid == 0:  # holder: keeps the lock's open file until release signals it
            os.setsid()
            null = os.open(os.devnull, os.O_RDWR)
            for n in (0, 1, 2):
                os.dup2(null, n)
            while True:
                signal.pause()
        with open(pidfile, "w") as f:
            json.dump({"pid": pid, "start": proc_identity(pid)[0]}, f)
        print("crew: land lock acquired (holder pid %d)" % pid)
        return 0
    with open(lock, "a") as f:
        for attempt in range(50):  # signal the holder, then await the unlock
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if attempt == 0:  # signal only our holder: same PID, same start time, a land-lock acquire
                    try:
                        with open(pidfile) as p:
                            rec = json.load(p)
                        live = proc_identity(int(rec["pid"]))
                    except (OSError, ValueError, TypeError, KeyError):
                        live = rec = None
                    if not live or live[0] != rec["start"] or "land-lock acquire" not in live[1]:
                        print("crew: refusing release: land lock %s is held, but not by the holder recorded in "
                              "merge.pid (stale or reused PID); nothing signalled" % lock)
                        return 1
                    os.kill(int(rec["pid"]), signal.SIGTERM)
                time.sleep(0.1)
        else:
            print("crew: land lock %s still held after release" % lock)
            return 1
    if os.path.exists(pidfile):
        os.remove(pidfile)
    print("crew: land lock released" if attempt else "crew: land lock not held")
    return 0


def identity(session, index):
    """Run identity for the probe: pane handle, pane pid and that process's start time (tmux.md Q7)."""
    p = tmux.pane(session, index) or {}
    return {"pane_id": p.get("id"), "pane_pid": p.get("pid"), "pane_start": tmux.proc_start(p["pid"]) if p else None}


def runs(state):
    d = os.path.join(state, "runs")
    for n in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        if n.endswith(".json"):
            with open(os.path.join(d, n)) as f:
                yield n[:-5], json.load(f)


def heartbeat(state, name):
    """Last status line and the time of the run's last progress (status file, else run record)."""
    status = os.path.join(state, "status", name + ".status")
    if not os.path.exists(status) or not os.path.getsize(status):
        return "", os.path.getmtime(os.path.join(state, "runs", name + ".json"))
    with open(status) as f:
        return f.read().splitlines()[-1], os.path.getmtime(status)


def probe(session, name, rec, windows):
    """C5 liveness from tmux, never from the agent: alive | dead | missing | ambiguous (tmux.md Q7)."""
    if windows.get(name) != rec.get("index"):
        return "missing"
    p = tmux.pane(session, rec["index"])
    if p is None:
        return "ambiguous"
    if (p["id"], p["pid"]) != (rec.get("pane_id"), rec.get("pane_pid")):
        return "missing"  # same name, another run
    if p["dead"] == "1":
        return "dead"
    if tmux.proc_start(p["pid"]) != rec.get("pane_start"):
        return "missing"
    return harness_up(session, rec["index"], p, [rec["harness"]])


def harness_up(session, index, p, harnesses):
    """alive with a harness in the foreground and no trust dialog on screen, else ambiguous (#139 F6)."""
    screen = tmux.capture(session, index)
    if "trust" in screen.lower() and "No, exit" in screen:
        return "ambiguous"
    return "alive" if set(harnesses) & {p["command"], *tmux.foreground(p["tty"])} else "ambiguous"


def scan(state, session, now, stale, seen):
    """Wake records: new status lines, and runs dead, missing or silent past stale; each fires once per key."""
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    wakes = []
    for name, rec in runs(state):
        status = os.path.join(state, "status", name + ".status")
        size, off = os.path.getsize(status) if os.path.exists(status) else 0, seen["offsets"].get(name, 0)
        if size and size != off:
            with open(status) as f:
                f.seek(off if size > off else 0)  # shorter than seen: a new run's file
                wakes += [{"reason": "status", "window": name, "line": s} for s in f.read().splitlines() if s.strip()]
        seen["offsets"][name] = size
        last, beat = heartbeat(state, name)
        cls = probe(session, name, rec, windows)
        if last.startswith(("done:", "failed:")) or (cls in ("alive", "ambiguous") and now - beat <= stale):
            continue
        key = "%s %s" % (cls, beat)
        if seen["keys"].get(name) != key:
            seen["keys"][name] = key
            wakes.append({"reason": "stale", "window": name, "liveness": cls, "silent": int(now - beat),
                          "action": "restart" if cls in ("dead", "missing") and not rec.get("restarts") else "escalate"})
    return wakes


def reason(w):
    if "event" in w:
        return "%s: %s" % (w["reason"], w["event"])
    if "line" in w:
        return "status: %s %s" % (w["window"], w["line"])
    return "stale: %s %s, silent %ds, %s" % (w["window"], w["liveness"], w["silent"], w["action"])


def queue_sig(wake):
    """(inode, byte size, mtime) of wake/queue.jsonl, or None; a change means records were appended or drained."""
    try:
        st = os.stat(os.path.join(wake, "queue.jsonl"))
    except FileNotFoundError:
        return None
    return [st.st_ino, st.st_size, st.st_mtime_ns]


def queued(state, wake, seen):
    """Records appended to queue.jsonl since the offset in seen (another poller's); never queued again."""
    with queue_lock(state):
        sig, old = queue_sig(wake), seen.get("queue")
        if sig == old or sig is None:
            seen["queue"] = sig
            return []
        with open(os.path.join(wake, "queue.jsonl"), encoding="utf-8") as f:
            f.seek(old[1] if old and old[0] == sig[0] and sig[1] > old[1] else 0)  # else drained: a new file
            lines = f.read().splitlines()
        seen["queue"] = sig
    records = []
    for line in lines:
        with contextlib.suppress(ValueError):  # a source killed mid-append leaves a partial line
            records.append(json.loads(line))
    return records


def watch(args):
    """Zero-token watcher: block on status files, liveness, one-shot --source commands and queue growth; queue
    wakes, then exit."""
    _, session, state = profile(args)
    wake = os.path.join(state, "wake")
    os.makedirs(wake, exist_ok=True)
    path, pidfile = os.path.join(wake, "watch-state.json"), os.path.join(wake, "watcher.pid")
    seen = {"offsets": {}, "keys": {}, "idle": 0, "queue": None}
    if os.path.exists(path):
        with open(path) as f:
            seen.update(json.load(f))

    def save(data):
        with open(path + ".tmp", "w") as f:
            json.dump(data, f)
        os.replace(path + ".tmp", path)

    def stop(signum, _frame):
        raise SystemExit(128 + signum)

    for sig in (signal.SIGTERM, signal.SIGINT):  # a killed watcher still removes its PID file and saves offsets
        signal.signal(sig, stop)
    busy = any(runs(state))
    seen["idle"] = 0 if busy else seen["idle"]
    deadline = time.monotonic() + min(args.backstop * 2 ** seen["idle"], args.backstop * 16)  # backs off when idle
    try:
        with open(pidfile, "w") as f:
            f.write("%d\n" % os.getpid())
        while True:
            found = []
            for cmd in args.source:  # one-shot commands, each cut off at one scan interval so none wedges the loop
                before = queue_sig(wake)
                try:
                    out = subprocess.run(shlex.split(cmd), capture_output=True, text=True,
                                         timeout=args.interval).stdout
                except subprocess.TimeoutExpired:
                    found.append({"reason": "source-timeout", "event": cmd})
                    continue
                if queue_sig(wake) == before:  # a source that queues its own records (crew poll) is not re-queued
                    found += [{"reason": "poll", "event": line} for line in out.splitlines() if line.strip()]
            trial = json.loads(json.dumps(seen))  # committed only once its wakes are queued
            wakes = scan(state, session, time.time(), args.stale, trial) + found
            others = queued(state, wake, trial)
            if not wakes and not others and time.monotonic() > deadline:
                trial["idle"] += 0 if busy else 1
                wakes = [{"reason": "backstop", "event": "due (%s in flight)" % ("work" if busy else "nothing")}]
            if wakes:
                with queue_lock(state), open(os.path.join(wake, "queue.jsonl"), "a") as f:
                    for w in wakes:
                        f.write(json.dumps(dict(w, at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))) + "\n")
                    f.flush()
                    trial["queue"] = queue_sig(wake)
            save(trial)
            seen = trial
            if wakes or others:
                break
            time.sleep(args.interval)
        p = None if args.no_nudge else tmux.pane(session, 0)
        if p and {p["command"], *tmux.foreground(p["tty"])} & set(ENGINE_CMD.values()) and \
                time.time() - float(p["activity"]) > args.idle:
            tmux.send_keys(session, 0, "wake: watcher")  # the Codex-recipe path, for when exit alone wakes nobody
        wakes += others
        print(reason(wakes[0]) + (" (+%d more in wake/queue.jsonl)" % (len(wakes) - 1) if len(wakes) > 1 else ""))
        return 0
    finally:
        save(seen)
        with contextlib.suppress(FileNotFoundError):
            os.remove(pidfile)


def status(args):
    """Table of role runs: window, role, item, head, last status line, heartbeat age, liveness."""
    _, session, state = profile(args)
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    rows = [("WINDOW", "ROLE", "ITEM", "HEAD", "BEAT", "LIVENESS", "LAST")]
    p = tmux.pane(session, 0) if 0 in windows.values() else None
    if p:
        rows.append(([n for n, i in windows.items() if i == 0][0], "coordinator", "-", "-", "-",
                     "dead" if p["dead"] == "1" else harness_up(session, 0, p, ENGINE_CMD.values()), "-"))
    for name, rec in runs(state):
        last, beat = heartbeat(state, name)
        head = subprocess.run(["git", "-C", rec.get("worktree") or "/nonexistent", "rev-parse", "--short=7", "HEAD"],
                              capture_output=True, text=True).stdout.strip() or "-"
        rows.append((name, rec["role"], rec["item"], head, "%dm" % ((time.time() - beat) // 60),
                     probe(session, name, rec, windows), last or "-"))
    widths = [max(len(r[i]) for r in rows) for i in range(6)]
    print("\n".join("  ".join(c.ljust(w) for c, w in zip(r, widths)) + "  " + r[6] for r in rows))
    return 0


def restart(args):
    """Restart a dead or missing run once: fresh worktree when clean, else its own worktree (tmux.md Q7)."""
    values, session, state = profile(args)
    rec = dict(runs(state)).get(args.window)
    if rec is None:
        print("crew: no run %s" % args.window)
        return 1
    cls = probe(session, args.window, rec, dict((n, i) for i, n in tmux.list_windows(session)))
    last = heartbeat(state, args.window)[0]
    problem = ("%s is %s; only dead or missing runs restart" % (args.window, cls) if cls not in ("dead", "missing")
               else "%s finished (%s); use crew kill" % (args.window, last) if last.startswith(("done:", "failed:"))
               else "%s already restarted once; escalate (crew:escalated, owner channel)" % args.window
               if rec.get("restarts") else None)
    if problem or "args" not in rec:
        print("crew: refusing restart: " + (problem or "%s has no spawn arguments" % args.window))
        return 1
    wt = rec.get("worktree")
    try:
        items = unlanded(values, rec, wt) if wt and os.path.isdir(wt) else []
    except RuntimeError as e:
        items = ["unchecked: %s" % e]
    if items:  # never delete unlanded work (#172): relaunch in the same worktree and claim instead
        return relaunch(values, session, state, args.window, rec, items, args.timeout)
    if kill_run(values, session, state, args.window):
        return 1
    a = rec["args"]
    argv = ["spawn", rec["role"], "--pass", a["pass"], "--round", str(a["round"]), "--tier", a["tier"],
            "--project", args.project] + (["--org-profile", args.org_profile] if args.org_profile else [])
    argv += (["--issue", str(a["issue"])] if a["issue"] else []) + (["--pr", str(a["pr"])] if a["pr"] else [])
    code = main(argv + ["--timeout", str(args.timeout)])
    for name, new in runs(state):
        if new.get("args") == a:
            new["restarts"] = 1
            with open(os.path.join(state, "runs", name + ".json"), "w") as f:
                json.dump(new, f, indent=2)
    return code


def relaunch(values, session, state, name, rec, items, timeout):
    """Restart a run whose worktree holds unlanded work: new window, same worktree, brief and claim."""
    brief = os.path.join(state, "runs", name + ".brief.md")
    for index, n in tmux.list_windows(session):
        if n == name:
            tmux.kill_window(session, index)
    used = [i for i, _ in tmux.list_windows(session)]
    free = [i for i in range(BANDS[rec["role"]][0], BANDS[rec["role"]][1] + 1) if i not in used]
    if not free or not os.path.exists(brief):
        print("crew: refusing restart: %s" % ("band %d-%d full" % BANDS[rec["role"]] if not free else
                                             "no brief %s" % brief))
        return 1
    index = rec["index"] if rec["index"] in free else free[0]
    wt = rec["worktree"]
    tmux.new_window(session, index, name, wt, window_env(values, state, rec["role"], name, brief),
                    LAUNCH % (shlex.join(harness(rec["engine"], rec["model"], rec["effort"], rec["pass"], wt)),
                              POINTER))
    try:
        wait_harness(session, index, name, rec["harness"], timeout)
    except RuntimeError as e:
        tmux.kill_window(session, index)
        print("%s; worktree, claim and run record kept" % str(e).replace("; cleaned up", ""))
        return 1
    rec.update(identity(session, index), index=index, restarts=1,
               start=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
    with open(os.path.join(state, "runs", name + ".json"), "w") as f:
        json.dump(rec, f, indent=2)
    print("crew: restarted %s (window %d) in its worktree %s, keeping unlanded work:\n  %s" % (
        name, index, wt, "\n  ".join(items)))
    return 0


def reconcile(state):
    """After crew up rebuilt the session from disk: report recorded runs; never respawn them (tmux.md Q7)."""
    names = [n for n, _ in runs(state)]
    if names:
        print("crew: rebuilt from %s; recorded runs now probe missing: %s (crew status; crew restart <window>)" % (
            state, ", ".join(names)))


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ["up", "down"]:
        p = sub.add_parser(name)
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
        if name == "up":
            p.add_argument("--inputs", default=TEMPLATES, help="render inputs dir (default: templates/)")
    sub.add_parser("guard").add_argument("--state", required=True)
    sp = sub.add_parser("spawn")
    sp.add_argument("role", choices=sorted(BANDS))
    sp.add_argument("--issue", type=int)
    sp.add_argument("--pr", type=int)
    sp.add_argument("--pass", dest="pass_", choices=sorted({p for v in PASSES.values() for p in v}))
    sp.add_argument("--round", type=int, default=1, help="verdict round k, for reviewer window names")
    sp.add_argument("--tier", default="default", choices=["trivial", "default", "deep"])
    sp.add_argument("--timeout", type=float, default=15.0, help="seconds to see the harness in the foreground")
    kp = sub.add_parser("kill")
    kp.add_argument("window")
    kp.add_argument("--discard", action="store_true", help="remove unlanded work; needs --reason")
    kp.add_argument("--reason", help="why the unlanded work is discarded; posted on the run's PR or issue")
    ap_ = sub.add_parser("attach")
    ap_.add_argument("target", help="window name, role (builder, reviewer, synthesizer, coordinator) or builders")
    ap_.add_argument("--rw", action="store_true", help="interactive attach; read-only by default")
    lp = sub.add_parser("logs")
    lp.add_argument("window")
    lp.add_argument("-n", "--lines", type=int, default=20)
    lp.add_argument("-f", "--follow", action="store_true")
    for p in [sp, kp, ap_, lp]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    snd = sub.add_parser("send")
    snd.add_argument("window")
    snd.add_argument("kind")
    snd.add_argument("refs", nargs="+")
    snd.add_argument("--wait-ack", type=float, help="seconds to wait for ack: <msg-id> in the status file")
    ak = sub.add_parser("acked")
    ak.add_argument("window")
    ak.add_argument("id")
    ak.add_argument("--wait", type=float, default=0.0, help="seconds to wait for the ack (default: check once)")
    pl = sub.add_parser("poll")
    pl.add_argument("--once", action="store_true", help="one poll, then exit (default: every poll_interval seconds)")
    for p in [snd, ak, pl]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    llp = sub.add_parser("land-lock")
    llp.add_argument("action", choices=["acquire", "release"])
    dp = sub.add_parser("dequeue")
    dp.add_argument("--timeout", type=float, default=15.0, help="seconds to see the harness in the foreground")
    for p in [llp, dp, sub.add_parser("drain")]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    wp = sub.add_parser("watch")
    wp.add_argument("--stale", type=float, default=900, help="seconds without status progress before a stale wake")
    wp.add_argument("--backstop", type=float, default=1800, help="seconds to a backstop wake; x2 per idle wake, max x16")
    wp.add_argument("--interval", type=float, default=5, help="seconds between scans; also each --source timeout")
    wp.add_argument("--source", action="append", default=[],
                    help="one-shot event command (crew poll --once); each stdout line is a poll wake")
    wp.add_argument("--no-nudge", action="store_true", help="do not type the wake line into an idle coordinator")
    wp.add_argument("--idle", type=float, default=30, help="seconds with no coordinator output that count as idle")
    rp = sub.add_parser("restart")
    rp.add_argument("window")
    rp.add_argument("--timeout", type=float, default=15.0)
    for p in [wp, sub.add_parser("status"), rp]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    args = ap.parse_args(argv)
    return {"up": up, "down": down, "guard": guard, "spawn": spawn, "kill": kill, "send": send,
            "acked": acked_cmd, "attach": attach, "logs": logs, "poll": poll, "land-lock": land_lock,
            "dequeue": dequeue, "drain": drain, "watch": watch, "status": status, "restart": restart}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
