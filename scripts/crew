#!/usr/bin/env python3
"""tmux crew CLI (docs/runtimes/tmux.md). Python 3.11+ stdlib only.

Usage: crew up --project FILE [--org-profile FILE] --inputs DIR
       crew down --project FILE [--org-profile FILE]
       crew spawn ROLE --issue N | --pr N [--pass PASS] [--round K] [--tier T] --project FILE [--org-profile FILE]
       crew kill WINDOW --project FILE [--org-profile FILE]
       crew send WINDOW KIND REF... [--wait-ack SECS] --project FILE
       crew acked WINDOW MSG-ID [--wait SECS] --project FILE
       crew poll [--once] --project FILE
       crew attach WINDOW|ROLE|builders [--rw] --project FILE [--org-profile FILE]
       crew logs WINDOW [-n N] [-f] --project FILE [--org-profile FILE]
       crew guard --state DIR   (Claude Code Stop hook; reads the hook JSON on stdin)
"""
import argparse
import contextlib
import fcntl
import glob
import importlib.util
import io
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))


def load(name, file):
    spec = importlib.util.spec_from_file_location(name, os.path.join(HERE, file))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


crew_render, tmux = load("crew_render", "crew-render.py"), load("crew_tmux", "crew-tmux.py")
POINTER = "Read your brief at $CREW_BRIEF and follow it."
# The token is derived inside the window's shell: never in argv, -e or a file (tmux.md Q5).
LAUNCH = 'export GH_TOKEN="$(gh auth token --user "$CREW_IDENTITY")"; exec %s "%s"'
ENGINE_CMD = {"claude-code": "claude", "codex": "codex"}
# Role windows (tmux.md Layout and naming): index band, passes (first is the default), default name.
BANDS = {"builder": (10, 19), "reviewer": (20, 29), "synthesizer": (1, 1)}
PASSES = {"builder": ["build", "fix"], "reviewer": ["review", "validate"], "synthesizer": ["land"]}
NAMES = {"builder": "ben", "reviewer": "vera", "synthesizer": "sam"}
TEMPLATES = os.path.join(os.path.dirname(HERE), "templates")


def brief_src(state, role):
    """Rendered role brief: briefs/<role>.md from core/, else the runtime binding's runtime/<role>.md (#137)."""
    core = os.path.join(state, "render", "briefs", role + ".md")
    return core if os.path.exists(core) else os.path.join(state, "render", "runtime", role + ".md")


def profile(args):
    """Resolved profile, session name and state dir; exit 1 on a resolve problem or a non-tmux runtime."""
    values, problems = crew_render.resolve(args.project, args.org_profile)
    if values and values["runtime.name"] != "tmux":
        problems = ["%s:runtime.name: runtime.name is %s, not tmux" % (args.project, values["runtime.name"])]
    if problems:
        print("\n".join(problems))
        sys.exit(1)
    owner, repo = values["repo.owner"], values["repo.name"]
    session = values.get("runtime.options.session") or "crew-%s-%s" % (owner, repo)
    return values, session, os.path.join(os.path.abspath(values["paths.state_dir"]), "%s__%s" % (owner, repo))


def install_stop_hook(project_dir, state):
    """Add the turn-end guard to the project's local Claude settings, once, keeping every other key."""
    path = os.path.join(project_dir, ".claude", "settings.local.json")
    settings = {}
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            settings = json.load(f)
    command = shlex.join(["python3", os.path.join(HERE, "crew"), "guard", "--state", state])
    stop = settings.setdefault("hooks", {}).setdefault("Stop", [])
    if not any(h.get("command") == command for entry in stop for h in entry.get("hooks", [])):
        stop.append({"hooks": [{"type": "command", "command": command}]})
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=2)
        f.write("\n")


def up(args):
    values, session, state = profile(args)
    if tmux.has_session(session):
        print("crew: %s already running; attach with: tmux attach -t %s" % (session, session))
        return 0
    render = os.path.join(state, "render")
    with contextlib.redirect_stdout(io.StringIO()) as out:
        code = crew_render.main(["--project", args.project, "--inputs", args.inputs, "--out", render] +
                                (["--org-profile", args.org_profile] if args.org_profile else []))
    if code:
        print(out.getvalue(), end="")
        return 1
    project_dir = os.path.dirname(os.path.abspath(args.project))
    engine = values["engines.coordinator"]
    if engine == "claude-code":
        install_stop_hook(project_dir, state)
    env = {"CREW_ROLE": "coordinator", "CREW_STATE": state, "CREW_IDENTITY": values["identities.coordinator.gh_user"],
           "CREW_BRIEF": brief_src(state, "coordinator")}
    window = values.get("identities.coordinator.name", "ash").lower()
    tmux.new_session(session, window, project_dir, env, LAUNCH % (ENGINE_CMD[engine], POINTER))
    print("crew: started %s (window 0 %s, %s); attach with: tmux attach -t %s" % (session, window, engine, session))
    return 0


def down(args):
    values, session, state = profile(args)
    if not tmux.has_session(session):
        print("crew: %s not running" % session)
        return 0
    lock = os.path.join(state, "locks", "merge.lock")
    if os.path.exists(lock):
        with open(lock) as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                print("crew: refusing down: the land lock %s is held" % lock)
                return 1
    for index, name in sorted(tmux.list_windows(session), reverse=True):  # role windows, coordinator last
        if index != 0:
            kill_run(values, session, state, name)
    tmux.kill_session(session)
    print("crew: stopped %s" % session)
    return 0


def guard(args):
    """Block a turn end while work is in flight (a run record or a queued wake) and no watcher is armed.

    At most one block per stop cycle: with stop_hook_active true (already continuing for this hook), allow
    with a warning. Malformed or empty stdin counts as not active."""
    try:
        active = json.loads(sys.stdin.read()).get("stop_hook_active") is True
    except (ValueError, AttributeError):
        active = False
    runs = os.path.join(args.state, "runs")
    queue = os.path.join(args.state, "wake", "queue.jsonl")
    busy = (os.path.isdir(runs) and any(n.endswith(".json") for n in os.listdir(runs))) or \
        (os.path.exists(queue) and os.path.getsize(queue) > 0)
    try:
        with open(os.path.join(args.state, "wake", "watcher.pid")) as f:
            os.kill(int(f.read().strip()), 0)
        armed = True
    except (OSError, ValueError):
        armed = False
    msg = "Work is in flight and no watcher is armed: drain wake/queue.jsonl and re-arm the watcher " \
        "before ending the turn (docs/runtimes/tmux.md Q1)."
    if busy and not armed:
        print(json.dumps({"systemMessage": "crew guard: " + msg} if active else {"decision": "block", "reason": msg}))
    return 0


def git(repo, *args):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("crew: git %s failed: %s" % (args[0], r.stderr.strip()))
    return r.stdout.strip()


def fetch(repo, ref):
    """Fresh base: always the just-fetched remote ref, never a possibly stale local one."""
    git(repo, "fetch", "-q", "origin", ref)
    return git(repo, "rev-parse", "FETCH_HEAD")


def pick_engine(values, tier, avoid=None):
    """First interactive engine in the tier's order; a reviewer avoids every actual builder engine of the PR, and
    an unknown builder engine counts as non-Claude (roles.md Reviewer engine selection)."""
    order = [e.split("/", 1) for e in values["engines.%s.order" % tier]]
    order = [e for e in order if e[0] in ENGINE_CMD and e[0] not in (avoid or ())]
    if avoid == set():
        order.sort(key=lambda e: e[0] != "claude-code")
    if not order:
        raise RuntimeError("crew: no %s engine in engines.%s.order differs from the builder's %s" %
                           ("/".join(ENGINE_CMD), tier, sorted(avoid or ())))
    return order[0][0], order[0][1], values["engines.%s.effort" % tier]


def harness(engine, model, effort, pass_, wt):
    if engine == "claude-code":
        return ["claude", "--model", model, "--effort", effort, "--permission-mode", "acceptEdits"]
    return ["codex", "-m", model, "-c", "model_reasoning_effort=" + effort,
            "-c", 'projects."%s".trust_level="trusted"' % wt,  # pre-trust this run's worktree only
            "-s", "read-only" if pass_ in ("review", "validate") else "workspace-write"]


def kill_run(values, session, state, name):
    """Stop the window, then remove only this run's worktree (build output inside it) and state files."""
    for index, n in tmux.list_windows(session):
        if n == name:
            tmux.kill_window(session, index)
    path = os.path.join(state, "runs", name + ".json")
    rec = {}
    if os.path.exists(path):
        with open(path) as f:
            rec = json.load(f)
    wt = rec.get("worktree")
    if wt and os.path.dirname(os.path.realpath(wt)) == os.path.realpath(values["paths.worktree_root"]):
        subprocess.run(["git", "-C", rec["repo"], "worktree", "remove", "--force", wt], capture_output=True)
        shutil.rmtree(wt, ignore_errors=True)
        subprocess.run(["git", "-C", rec["repo"], "worktree", "prune"], capture_output=True)
    for p in [path, os.path.join(state, "runs", name + ".brief.md"), os.path.join(state, "inbox", name + ".jsonl"),
              os.path.join(state, "status", name + ".status"), rec.get("claim")]:
        if p and os.path.exists(p):
            os.remove(p)


def spawn(args):
    values, session, state = profile(args)
    role = args.role
    pass_ = args.pass_ or PASSES[role][1 if role == "builder" and args.pr else 0]
    if pass_ not in PASSES[role] or bool(args.issue) != (role == "builder") or \
            bool(args.pr) != (role != "builder" or pass_ == "fix"):
        print("crew: %s %s takes %s" % (role, pass_, "--issue N --pr N" if pass_ == "fix" else
                                         "--issue N" if role == "builder" else "--pr N"))
        return 2
    nm = values.get("identities.%s.name" % role, NAMES[role]).lower()
    name = {"builder": "%s-%s" % (nm, args.issue), "synthesizer": nm,
            "reviewer": "%s-%s-r%d-%s" % (nm, args.pr, args.round, pass_)}[role]
    if not tmux.has_session(session):
        print("crew: session %s not reachable (tmux socket, or run crew up first)" % session)
        return 1
    tmux.pin_layout(session)
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    free = [i for i in range(BANDS[role][0], BANDS[role][1] + 1) if i not in windows.values()]
    src = brief_src(state, role)
    problem = ("%s already running" % name if name in windows else "band %d-%d full" % BANDS[role] if not free
               else "no rendered brief %s (run crew up)" % src if not os.path.exists(src) else None)
    if problem:
        print("crew: refusing spawn: " + problem)
        return 1
    try:
        repo = git(os.path.dirname(os.path.abspath(args.project)), "rev-parse", "--show-toplevel")
        sha = fetch(repo, "pull/%d/head" % args.pr if args.pr else values["repo.default_branch"])
        engine, model, effort = pick_engine(values, args.tier) if role == "builder" else pick_engine(
            values, args.tier, {line.split()[0] for line in git(
                repo, "log", "--format=%(trailers:key=Engine,valueonly)",
                "%s..%s" % (fetch(repo, values["repo.default_branch"]), sha)).splitlines()
                if line.strip() and not line.startswith("none")})
    except RuntimeError as e:
        print(e)
        return 1
    claim = os.path.join(state, "claims", "builder-issue%s" % args.issue if pass_ == "build" else
                         "%s-pr%d-%s" % (role, args.pr, sha[:7]))
    for d in ["claims", "runs", "inbox", "status"]:
        os.makedirs(os.path.join(state, d), exist_ok=True)
    try:
        os.close(os.open(claim, os.O_CREAT | os.O_EXCL | os.O_WRONLY))  # atomic claim (protocol §6 step 2)
    except FileExistsError:
        print("crew: refusing spawn: claim %s exists" % claim)
        return 1
    item = "issue #%s" % args.issue if role == "builder" else "PR #%d" % args.pr
    item += ", PR #%d" % args.pr if pass_ == "fix" else ""
    wt = os.path.join(os.path.abspath(values["paths.worktree_root"]), "%d-%s-%s-%s" % (
        args.pr or args.issue, sha[:7], role, pass_))
    rec = {"index": free[0], "role": role, "item": item, "pass": pass_, "repo": repo, "worktree": None, "claim": claim,
           "engine": engine, "model": model, "effort": effort, "harness": ENGINE_CMD[engine]}

    def save():
        with open(os.path.join(state, "runs", name + ".json"), "w") as f:
            json.dump(rec, f, indent=2)

    save()
    try:
        real, top = os.path.realpath(wt), os.path.realpath(repo)
        if real == top or real.startswith(top + os.sep):
            raise RuntimeError("crew: refusing spawn: %s is inside the primary checkout %s" % (wt, repo))
        if os.path.lexists(wt):
            raise RuntimeError("crew: refusing spawn: %s exists" % wt)
        os.makedirs(os.path.dirname(wt), exist_ok=True)
        git(repo, "worktree", "add", "-q", "--detach", wt, sha)
        rec["worktree"] = wt
        save()
        brief = os.path.join(state, "runs", name + ".brief.md")
        with open(src, encoding="utf-8") as f, open(brief, "w", encoding="utf-8") as out:
            out.write(f.read() + "\n## This run\n\n" + "".join("- %s: %s\n" % kv for kv in [
                ("Window", name), ("Item", item), ("Pass", pass_), ("Worktree", wt), ("Base", sha),
                ("Engine", "%s %s %s" % (engine, model, effort)), ("Claim", claim)]))
        env = {"CREW_ROLE": role, "CREW_ID": name, "CREW_STATE": state, "CREW_BRIEF": brief,
               "CREW_STATUS": os.path.join(state, "status", name + ".status"),
               "CREW_INBOX": os.path.join(state, "inbox", name + ".jsonl"),
               "CREW_IDENTITY": values["identities.%s.gh_user" % role]}
        if engine == "codex" and "=" in os.environ.get("CREW_SANDBOX_ENV", ""):  # NAME=VALUE from the org pack
            key, value = os.environ["CREW_SANDBOX_ENV"].split("=", 1)
            env[key] = value
        tmux.new_window(session, free[0], name, wt, env,
                        LAUNCH % (shlex.join(harness(engine, model, effort, pass_, wt)), POINTER))
        deadline = time.monotonic() + args.timeout
        while (seen := tmux.pane_command(session, free[0])) != ENGINE_CMD[engine]:
            if time.monotonic() > deadline:
                raise RuntimeError("failed: %s: foreground is %r, not %s, after %ss; cleaned up" % (
                    name, seen, ENGINE_CMD[engine], args.timeout))
            time.sleep(0.2)
    except (RuntimeError, OSError) as e:
        kill_run(values, session, state, name)
        print(e)
        return 1
    rec["start"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    save()
    print("crew: started %s (window %d, %s %s %s) in %s" % (name, free[0], engine, model, effort, wt))
    return 0


def kill(args):
    values, session, state = profile(args)
    if tmux.has_session(session):
        tmux.pin_layout(session)
    windows = dict((n, i) for i, n in tmux.list_windows(session))
    if windows.get(args.window) == 0:
        print("crew: refusing to kill the coordinator window; use crew down")
        return 1
    if args.window not in windows and not os.path.exists(os.path.join(state, "runs", args.window + ".json")):
        print("crew: no run %s" % args.window)
        return 1
    kill_run(values, session, state, args.window)
    print("crew: killed %s" % args.window)
    return 0


# crew send (tmux.md C3): refs only. A ref is an issue/PR number, a full SHA, an https link or a path; no whitespace,
# so no diff or log fits, and lines that open a diff hunk or a traceback are refused outright.
KIND = re.compile(r"[a-z][a-z0-9-]{0,31}")
REF = re.compile(r"#\d+|[0-9a-f]{40}|https://[^\s]+|[\w.~/-]+")
MARKER = re.compile(r"^(---|\+\+\+|@@)|Traceback")
MAX_REF, MAX_LINE = 200, 1024


def acked(state, window, msg_id):
    """Delivery proof: an `ack: <msg-id>` line in the window's status file, nothing else."""
    try:
        with open(os.path.join(state, "status", window + ".status"), encoding="utf-8") as f:
            return any(line.split()[:2] == ["ack:", msg_id] for line in f)
    except FileNotFoundError:
        return False


def wait_ack(state, window, msg_id, secs):
    deadline = time.monotonic() + secs
    while not acked(state, window, msg_id):
        if time.monotonic() >= deadline:
            print("crew: no ack: %s from %s after %ss" % (msg_id, window, secs))
            return 3
        time.sleep(0.2)
    print("crew: acked %s by %s" % (msg_id, window))
    return 0


def send(args):
    values, session, state = profile(args)
    bad = [r for r in args.refs if len(r) > MAX_REF or not REF.fullmatch(r) or MARKER.search(r)]
    if not KIND.fullmatch(args.kind) or bad:
        print("crew: refusing send: refs only (issue/PR #n, full SHA, https link, path; max %d chars each): %s" %
              (MAX_REF, ", ".join(repr(r[:40]) for r in bad) or "bad kind %r" % args.kind[:40]))
        return 2
    msg = {"id": "%s-%s" % (time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()), os.urandom(3).hex()), "kind": args.kind,
           "refs": args.refs, "from": os.environ.get("CREW_ID") or os.environ.get("CREW_ROLE") or "coordinator",
           "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    line = json.dumps(msg) + "\n"
    if len(line.encode()) > MAX_LINE:
        print("crew: refusing send: message is %d bytes, over %d; send fewer refs" % (len(line.encode()), MAX_LINE))
        return 2
    index = dict((n, i) for i, n in tmux.list_windows(session)).get(args.window) if tmux.has_session(session) else None
    if index is None:
        print("crew: refusing send: no window %s in %s" % (args.window, session))
        return 1
    os.makedirs(os.path.join(state, "inbox"), exist_ok=True)
    with open(os.path.join(state, "inbox", args.window + ".jsonl"), "a", encoding="utf-8") as f:
        f.write(line)
    tmux.send_keys(session, index, "inbox: " + msg["id"])  # a nudge only; the inbox file is the message
    print("crew: sent %s to %s" % (msg["id"], args.window))
    return wait_ack(state, args.window, msg["id"], args.wait_ack) if args.wait_ack is not None else 0


def acked_cmd(args):
    return wait_ack(profile(args)[2], args.window, args.id, args.wait)



# crew poll (tmux.md Q1, C2): one wake source. Read-only gh JSON for open crew PRs and crew:ready items is diffed
# against poll-state.json; each change becomes one wake record in wake/queue.jsonl naming one consuming role
# (protocol §8). The coordinator drains the queue and routes each record by crew send or crew spawn.
CONSUMER = {"ci-passed": "reviewer", "ci-failed": "builder", "review-changes-requested": "builder",
            "review-approved": "synthesizer", "pr-merged": "coordinator", "pr-closed": "coordinator",
            "issue-assigned": "builder"}
PR_FIELDS = "number,state,headRefOid,labels,statusCheckRollup,reviews"
CREW_LINE = re.compile(r"<!-- crew:v1 ([^>]*?) -->")
CI_OK, CI_BAD = {"SUCCESS", "NEUTRAL", "SKIPPED"}, {"FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED",
                                                    "STARTUP_FAILURE"}


def pr_snapshot(pr):
    """Head, CI rollup and the latest verdict at head, from the hidden crew:v1 lines only (protocol §4)."""
    head = pr["headRefOid"]
    results = [c.get("state") if c.get("__typename") == "StatusContext" else
               c.get("conclusion") if c.get("status") == "COMPLETED" else "PENDING" for c in pr["statusCheckRollup"]]
    ci = "failed" if CI_BAD & set(results) else "passed" if results and set(results) <= CI_OK else "pending"
    verdict = None
    for review in pr["reviews"]:
        for line in CREW_LINE.findall(review["body"]):
            m = dict(kv.split("=", 1) for kv in line.split() if "=" in kv)
            if m.get("role") == "reviewer-validator" and m.get("pass") == "verdict" and m.get("sha") == head:
                verdict = m.get("verdict")
    return {"head": head, "ci": ci, "verdict": verdict}


def decide(prev, prs, issues):
    """Pure: previous poll state plus gh JSON (open PRs, tracked PRs now merged or closed, open issues) -> (events,
    new state). A change emits one event; no change emits nothing."""
    events, state = [], {"prs": {}, "issues": []}

    def emit(event, *refs):
        events.append({"event": event, "consumer": CONSUMER[event], "refs": list(refs)})

    for pr in prs:
        n, cur = str(pr["number"]), pr_snapshot(pr)
        if pr["state"] != "OPEN":
            emit("pr-merged" if pr["state"] == "MERGED" else "pr-closed", "#" + n, cur["head"])
            continue
        if not any(label["name"].startswith("crew:") for label in pr["labels"]):
            continue
        old = prev.get("prs", {}).get(n, {})
        state["prs"][n] = cur
        if cur["ci"] in ("passed", "failed") and (cur["head"], cur["ci"]) != (old.get("head"), old.get("ci")):
            emit("ci-" + cur["ci"], "#" + n, cur["head"])
        if cur["verdict"] and (cur["head"], cur["verdict"]) != (old.get("head"), old.get("verdict")):
            emit("review-approved" if cur["verdict"] == "pass" else "review-changes-requested", "#" + n, cur["head"])
    state["issues"] = sorted(i["number"] for i in issues if i["assignees"] and
                             any(label["name"] == "crew:ready" for label in i["labels"]))
    for n in state["issues"]:
        if n not in prev.get("issues", []):
            emit("issue-assigned", "#%d" % n)
    return events, state


def gh_json(*args):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError("crew: gh %s failed: %s" % (" ".join(args[:2]), r.stderr.strip()))
    return json.loads(r.stdout)


def poll_once(values, state):
    repo, path = "%s/%s" % (values["repo.owner"], values["repo.name"]), os.path.join(state, "poll-state.json")
    prev = None
    if os.path.exists(path):
        with open(path) as f:
            prev = json.load(f)
    prs = gh_json("pr", "list", "-R", repo, "--state", "open", "--limit", "200", "--json", PR_FIELDS)
    gone = set((prev or {}).get("prs", {})) - {str(pr["number"]) for pr in prs}
    prs += [gh_json("pr", "view", n, "-R", repo, "--json", PR_FIELDS) for n in sorted(gone)]
    issues = gh_json("issue", "list", "-R", repo, "--state", "open", "--label", "crew:ready", "--limit", "200",
                     "--json", "number,labels,assignees")
    events, new = decide(prev or {}, prs, issues)
    if prev is None:  # first run: record a baseline only; the §6 step 3 sweep covers what happened before it
        events = []
        print("crew: poll: baseline of %d PRs, %d issues" % (len(new["prs"]), len(new["issues"])))
    os.makedirs(os.path.join(state, "wake"), exist_ok=True)
    with open(os.path.join(state, "wake", "queue.jsonl"), "a", encoding="utf-8") as f:  # queue first: at-least-once
        for e in events:
            ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
            f.write(json.dumps({"id": "poll-%s-%s" % (ts, os.urandom(3).hex()), "source": "poll", "reason": "poll", **e, "ts": ts}) + "\n")
            print("crew: poll: %s -> %s %s" % (e["event"], e["consumer"], " ".join(e["refs"])))
    with open(path + ".tmp", "w") as f:
        json.dump(new, f, indent=2)
    os.replace(path + ".tmp", path)


def poll(args):
    values, _, state = profile(args)
    while True:
        try:
            poll_once(values, state)
        except RuntimeError as e:
            print(e)
            if args.once:
                return 1
        if args.once:
            return 0
        time.sleep(values["runtime.options.poll_interval"])


# Observe (#138): attach to a window, or tail a run's step summary (docs/observe.md).
ROLE_BANDS = dict(BANDS, coordinator=(0, 0))
# One pane of the builders view: the last lines of a window's screen (trailing blanks dropped), refreshed every second.
# Values are single-quoted: shlex.quote leaves "=" bare, which zsh (a common default-shell) expands.
SNAPSHOT = "while :; do out=$(tmux capture-pane -p -t '%s' | awk 'NF { n = NR } { l[NR] = $0 } " \
    "END { for (i = 1; i <= n; i++) print l[i] }' | tail -n \"$(($(tput lines) - 1))\"); " \
    "printf '\\033[H\\033[2J== %%s ==\\n%%s' '%s' \"$out\"; sleep 1; done"


def attach(args):
    """Attach read-only (--rw to type) to a window, or to a role's only window; `builders` opens a temporary tiled
    view of the builder band in a separate session, killed on detach, so the crew layout never changes."""
    values, session, state = profile(args)
    if not tmux.has_session(session):
        print("crew: %s not running" % session)
        return 1
    windows = sorted(tmux.list_windows(session))
    if args.target == "builders":
        band = [(i, n) for i, n in windows if BANDS["builder"][0] <= i <= BANDS["builder"][1]]
        if not band:
            print("crew: no builder windows")
            return 1
        name = "%s-builders-%d" % (session, os.getpid())
        tmux.view(name, [SNAPSHOT % ("=%s:%d" % (session, i), n) for i, n in band])
        try:
            return tmux.attach("=" + name, not args.rw)
        finally:
            tmux.kill_session(name)
    found = [(i, n) for i, n in windows if n == args.target]
    if not found and args.target in ROLE_BANDS:
        lo, hi = ROLE_BANDS[args.target]
        found = [(i, n) for i, n in windows if lo <= i <= hi]
        if len(found) > 1:
            print("crew: %s has several windows (%s); name one" % (args.target, ", ".join(n for _, n in found)))
            return 1
    if not found:
        print("crew: no window %s in %s" % (args.target, session))
        return 1
    return tmux.attach("=%s:%d" % (session, found[0][0]), not args.rw)


def logs(args):
    """Print the tail of the newest step summary under the run's worktree; never raw logs (docs/observe.md)."""
    values, session, state = profile(args)
    path = os.path.join(state, "runs", args.window + ".json")
    if not os.path.exists(path):
        print("crew: no run %s" % args.window)
        return 1
    with open(path) as f:
        wt = json.load(f).get("worktree")
    found = glob.glob(os.path.join(wt, ".crew", "runs", "**", "summary.md"), recursive=True) if wt else []
    if not found:
        print("crew: no step summary yet under %s" % os.path.join(str(wt), ".crew", "runs"))
        return 1
    summary = max(found, key=os.path.getmtime)
    if args.follow:
        os.execvp("tail", ["tail", "-n", str(args.lines), "-f", summary])
    with open(summary, encoding="utf-8") as f:
        lines = f.read().splitlines()
    print("==> %s <==" % summary)
    print("\n".join(lines[-args.lines:]))
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ["up", "down"]:
        p = sub.add_parser(name)
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
        if name == "up":
            p.add_argument("--inputs", default=TEMPLATES, help="render inputs dir (default: templates/)")
    sub.add_parser("guard").add_argument("--state", required=True)
    sp = sub.add_parser("spawn")
    sp.add_argument("role", choices=sorted(BANDS))
    sp.add_argument("--issue", type=int)
    sp.add_argument("--pr", type=int)
    sp.add_argument("--pass", dest="pass_", choices=sorted({p for v in PASSES.values() for p in v}))
    sp.add_argument("--round", type=int, default=1, help="verdict round k, for reviewer window names")
    sp.add_argument("--tier", default="default", choices=["trivial", "default", "deep"])
    sp.add_argument("--timeout", type=float, default=15.0, help="seconds to see the harness in the foreground")
    kp = sub.add_parser("kill")
    kp.add_argument("window")
    ap_ = sub.add_parser("attach")
    ap_.add_argument("target", help="window name, role (builder, reviewer, synthesizer, coordinator) or builders")
    ap_.add_argument("--rw", action="store_true", help="interactive attach; read-only by default")
    lp = sub.add_parser("logs")
    lp.add_argument("window")
    lp.add_argument("-n", "--lines", type=int, default=20)
    lp.add_argument("-f", "--follow", action="store_true")
    for p in [sp, kp, ap_, lp]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    snd = sub.add_parser("send")
    snd.add_argument("window")
    snd.add_argument("kind")
    snd.add_argument("refs", nargs="+")
    snd.add_argument("--wait-ack", type=float, help="seconds to wait for ack: <msg-id> in the status file")
    ak = sub.add_parser("acked")
    ak.add_argument("window")
    ak.add_argument("id")
    ak.add_argument("--wait", type=float, default=0.0, help="seconds to wait for the ack (default: check once)")
    pl = sub.add_parser("poll")
    pl.add_argument("--once", action="store_true", help="one poll, then exit (default: every poll_interval seconds)")
    for p in [snd, ak, pl]:
        p.add_argument("--project", required=True)
        p.add_argument("--org-profile")
    args = ap.parse_args(argv)
    return {"up": up, "down": down, "guard": guard, "spawn": spawn, "kill": kill, "send": send,
            "acked": acked_cmd, "attach": attach, "logs": logs, "poll": poll}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
