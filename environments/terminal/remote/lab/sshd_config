# Lab test host sshd (#1356): public key only, runner user only; no forwarding, agent or user env.
# The forced key line carries `restrict`, so it gets no TTY.
Port 22
HostKey /etc/ssh/crew-lab/ssh_host_ed25519_key
AllowUsers crew
PermitRootLogin no
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PermitUserEnvironment no
AllowAgentForwarding no
AllowTcpForwarding no
AllowStreamLocalForwarding no
X11Forwarding no
PermitTunnel no
